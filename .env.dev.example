# SSMS API — DEVELOPMENT environment
#
# Copy to .env.dev and fill in. .env.dev is gitignored.
#   cp .env.dev.example .env.dev
#
# Used by:
#   SSMS_ENV=dev ./scripts/db.sh ...
#   SSMS_ENV=dev ./scripts/admin.sh bootstrap
#   npm run start:dev  (via scripts/dev.sh, or copy to .env)

# Self-identification — scripts/env.sh refuses to load this file as any other
# environment. Do not change.
SSMS_ENV_NAME=dev

# Optional but recommended: pin the Supabase project ref. If SUPABASE_URL ever
# gets pasted from another project, scripts abort instead of running.
SSMS_EXPECT_PROJECT_REF=pyoghssleatymfmikrgx

# --- Supabase -------------------------------------------------------------
# Project URL — Settings → API → Project URL
SUPABASE_URL=https://pyoghssleatymfmikrgx.supabase.co

# Secret API key (`sb_secret_...`) — Settings → API Keys → Secret keys.
# Server-only; bypasses RLS by design. NEVER ship to the frontend.
SUPABASE_SECRET_KEY=

# Publishable API key (`sb_publishable_...`). Safe for clients. Not required by
# the backend; kept here so the portal's value has one source of truth.
SUPABASE_PUBLISHABLE_KEY=

# Storage bucket for instructor photos.
SUPABASE_STORAGE_BUCKET=instructor-public

# --- Database (ops scripts only) -----------------------------------------
# Supabase dashboard → Connect → *Session pooler*.
# The direct db.<ref>.supabase.co host is IPv6-only and will not resolve on
# most networks — use the pooler string.
DATABASE_URL=

# --- App ------------------------------------------------------------------
PORT=3000

# CORS allow-list for the browser portal (comma-separated origins).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Resend) -------------------------------------------------------
# Leave unset in dev to make the mailer a no-op. Set to a real key only if you
# want dev to actually send mail — it will send to real inboxes.
RESEND_API_KEY=
MAIL_FROM=Snow School (dev) <onboarding@resend.dev>

# --- First-admin bootstrap ------------------------------------------------
# Consumed by scripts/admin.sh bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
