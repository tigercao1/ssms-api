# Supabase config. NEVER commit a filled-in .env.
# Copy this file to .env and fill it there (.env is gitignored).

# Project URL — Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Secret API key (`sb_secret_...`) — Settings → API Keys → Secret keys.
# Replaces the legacy service_role key. Server-only; bypasses RLS by design,
# so it must NEVER reach the frontend.
SUPABASE_SECRET_KEY=

# Publishable API key (`sb_publishable_...`) — Settings → API Keys.
# Replaces the legacy anon key. Safe for clients. Not required by the backend
# in v1 (NestJS uses the secret key for all access); kept here for reference.
SUPABASE_PUBLISHABLE_KEY=

# JWT verification uses the asymmetric ES256 signing key via JWKS.
# Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json — only set this to
# override (e.g. tests pointing at a local JWKS).
# SUPABASE_JWKS_URL=

# Storage bucket for instructor photos.
SUPABASE_STORAGE_BUCKET=instructor-public

# App
PORT=3000

# CORS allow-list for the browser portal (comma-separated origins).
# v1 posture is deny-all browser origins; leave UNSET to keep CORS off (the
# public API is server-to-server). Set to the portal origin(s) to enable the
# instructor/admin portal, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://portal.snowschool.example
CORS_ALLOWED_ORIGINS=
