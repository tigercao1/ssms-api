# SSMS API — PRODUCTION environment
#
# Copy to .env.prod and fill in. .env.prod is gitignored.
#   cp .env.prod.example .env.prod
#
# Used ONLY by ops scripts run from a laptop:
#   SSMS_ENV=prod ./scripts/db.sh ...
#   SSMS_ENV=prod ./scripts/admin.sh bootstrap
#
# The running API does NOT read this file — Fly holds the real values:
#   fly secrets set SUPABASE_URL=... SUPABASE_SECRET_KEY=... etc.
# Keep the two in sync manually, or use `./scripts/deploy.sh secrets` which
# pushes this file's app-facing keys to Fly.

# Self-identification — scripts/env.sh refuses to load this file as any other
# environment. Do not change.
SSMS_ENV_NAME=prod

# Pin the production project ref. Any mismatch with SUPABASE_URL aborts the
# script — this is the last line of defence against a copy-paste accident.
SSMS_EXPECT_PROJECT_REF=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://<prod-ref>.supabase.co

# Secret API key (`sb_secret_...`). Server-only; bypasses RLS.
SUPABASE_SECRET_KEY=

# Publishable API key (`sb_publishable_...`) — the portal's build-time value.
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_STORAGE_BUCKET=instructor-public

# --- Database (ops scripts only) -----------------------------------------
# Supabase dashboard → Connect → *Session pooler* (IPv4). Required for
# migrations, seeds and pg_dump backups.
DATABASE_URL=

# --- App ------------------------------------------------------------------
PORT=3000

# Must exactly match the deployed portal origin, or every browser call fails
# CORS. No trailing slash.
CORS_ALLOWED_ORIGINS=https://app.<domain>

# --- Email (Resend) -------------------------------------------------------
# Required in prod: without these the mailer silently no-ops and instructors
# are never told they were approved/rejected.
RESEND_API_KEY=
MAIL_FROM=Snow School <noreply@<domain>>

# --- First-admin bootstrap ------------------------------------------------
# Consumed by scripts/admin.sh bootstrap. Clear these after the first run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
