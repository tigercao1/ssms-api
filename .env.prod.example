# SSMS API — PRODUCTION environment
#
# Copy to .env.prod and fill in. .env.prod is gitignored.
#   cp .env.prod.example .env.prod
#
# Used ONLY by ops scripts run from a laptop:
#   SSMS_ENV=prod ./scripts/db.sh ...
#   SSMS_ENV=prod ./scripts/admin.sh bootstrap
#
# The running API does NOT read this file — Fly holds the real values:
#   fly secrets set SUPABASE_URL=... SUPABASE_SECRET_KEY=... etc.
# Keep the two in sync manually, or use `./scripts/deploy.sh secrets` which
# pushes this file's app-facing keys to Fly.

# Self-identification — scripts/env.sh refuses to load this file as any other
# environment. Do not change.
SSMS_ENV_NAME=prod

# Pin the production project ref. Any mismatch with SUPABASE_URL aborts the
# script — this is the last line of defence against a copy-paste accident.
SSMS_EXPECT_PROJECT_REF=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://<prod-ref>.supabase.co

# Secret API key (`sb_secret_...`). Server-only; bypasses RLS.
SUPABASE_SECRET_KEY=

# Publishable API key (`sb_publishable_...`) — the portal's build-time value.
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_STORAGE_BUCKET=instructor-public

# --- Database (ops scripts only) -----------------------------------------
# Supabase dashboard → Connect → *Session pooler* (IPv4). Required for
# migrations, seeds and pg_dump backups.
DATABASE_URL=

# --- App ------------------------------------------------------------------
PORT=3000

# Must exactly match the deployed portal origin, or every browser call fails
# CORS. No trailing slash.
CORS_ALLOWED_ORIGINS=https://app.<domain>

# --- Email (Resend) -------------------------------------------------------
# Required in prod: without these the mailer silently no-ops and instructors
# are never told they were approved/rejected.
RESEND_API_KEY=
MAIL_FROM='Serendipity Snow <noreply@contact.ssnow.club>'
# Optional. Reply-To on every email (default info@ssnow.club).
MAIL_REPLY_TO=info@ssnow.club
# Optional. PNG logo in the email header (default https://app.ssnow.club/email-logo.png).
EMAIL_LOGO_URL=
# Portal base URL for links in emails (default https://app.ssnow.club in production).
PORTAL_URL=https://app.ssnow.club

# --- Shopify Admin API ----------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SYNC_ENABLED=false
SHOPIFY_RECONCILE_TOKEN=
SHOPIFY_STOREFRONT_PREVIEW_BASE_URL=https://ssnow.club/pages/our-team-preview/
CUSTOMER_SYNC_ENABLED=false

# --- Translation (Gemini) ------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TRANSLATION_ENABLED=false

# --- Public pages (docs Worker) -----------------------------------------
# Base URL of the docs Worker that stores and serves public HTML pages.
DOCS_WORKER_URL=https://docs.ssnow.club
# Required in prod: shared secret for the Worker's internal object API (same value as the Worker's DOCS_INTERNAL_TOKEN secret).
DOCS_INTERNAL_TOKEN=

# --- Google Calendar ------------------------------------------------------
# Optional: Google features stay off until these are set and an admin connects. GOOGLE_TOKEN_ENC_KEY is base64 of 32 random bytes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENC_KEY=
GOOGLE_OAUTH_REDIRECT_URI=https://ssms-api-vivid-brook-6788.fly.dev/admin/google/oauth/callback
GOOGLE_ALLOWED_ACCOUNT=admin@ssnow.club
GOOGLE_OAUTH_RETURN_URL=https://app.ssnow.club/admin/settings/google

# --- First-admin bootstrap ------------------------------------------------
# Consumed by scripts/admin.sh bootstrap. Clear these after the first run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
